# Configuración de Coverage para medir cobertura de tests
[run]
source = .
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */__pycache__/*
    */venvautonew/*
    */env/*
    */venv/*
    manage.py
    */asgi.py
    */wsgi.py
    */settings.py
    */apps.py
    */admin.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if settings.DEBUG
    if DEBUG
    pass
    
precision = 2
show_missing = True

[html]
directory = htmlcov
